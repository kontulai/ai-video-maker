# Google AI Studio / Gemini API key (paid tier needed for Gemini 4 Argon and Gemini Omni)
GEMINI_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=
# Voice to use. Default is "Rachel". Find others at https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Model overrides (optional)
PROMPT_MODEL=gemini-4-argon
VIDEO_MODEL=gemini-omni-1.1-flash
# Model that watches each clip for unwanted lettering (defaults to PROMPT_MODEL)
# TEXT_CHECK_MODEL=gemini-4-argon
# Image model for the web app's setting preview
# IMAGE_MODEL=gemini-3.1-flash-image-preview

# Fonts for the on-screen keyword graphics: exact installed face names
CALLOUT_FONT=Avenir Next Bold
CALLOUT_FONT_HEAVY=Avenir Next Heavy

# Where the web app keeps its projects
# PROJECTS_DIR=projects
